// ── Tibetan Bowl ──────────────────────────────────────────────
let audioCtx=null;

function bell(type='phase'){
  try{
    if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
    const ctx=audioCtx;
    function doPlay(){
      const t=ctx.currentTime;
      const bowl = type==='done'
        ? { f:180, vol:0.09, partials:[[1,1.0,9.0],[2.756,0.45,6.5],[5.404,0.20,4.2],[8.933,0.09,2.8],[13.35,0.04,1.6]] }
        : { f:324, vol:0.065, partials:[[1,1.0,6.0],[2.756,0.42,4.5],[5.404,0.18,3.0],[8.933,0.08,2.0],[13.35,0.035,1.2]] };
      const comp=ctx.createDynamicsCompressor();
      comp.threshold.value=-18; comp.knee.value=12; comp.ratio.value=3;
      comp.attack.value=0.003; comp.release.value=0.4; comp.connect(ctx.destination);
      const master=ctx.createGain();
      master.gain.setValueAtTime(0,t);
      master.gain.linearRampToValueAtTime(bowl.vol,t+0.008);
      master.gain.setValueAtTime(bowl.vol,t+0.012);
      master.gain.exponentialRampToValueAtTime(0.0001,t+bowl.partials[0][2]+1);
      master.connect(comp);
      const bufLen=ctx.sampleRate*0.04;
      const noiseBuf=ctx.createBuffer(1,bufLen,ctx.sampleRate);
      const nd=noiseBuf.getChannelData(0);
      for(let i=0;i<bufLen;i++) nd[i]=(Math.random()*2-1)*Math.pow(1-i/bufLen,4)*0.35;
      const ns=ctx.createBufferSource(); ns.buffer=noiseBuf;
      const nf=ctx.createBiquadFilter(); nf.type='bandpass'; nf.frequency.value=bowl.f*3; nf.Q.value=2;
      const ng=ctx.createGain(); ng.gain.setValueAtTime(0.6,t); ng.gain.exponentialRampToValueAtTime(0.0001,t+0.06);
      ns.connect(nf); nf.connect(ng); ng.connect(master); ns.start(t); ns.stop(t+0.07);
      bowl.partials.forEach(([ratio,amp,decay])=>{
        const osc=ctx.createOscillator(); const g=ctx.createGain();
        osc.type='sine'; osc.frequency.value=bowl.f*ratio;
        if(ratio===1){ osc.frequency.setValueAtTime(bowl.f*1.002,t); osc.frequency.exponentialRampToValueAtTime(bowl.f,t+0.3); }
        g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(amp,t+0.01); g.gain.exponentialRampToValueAtTime(0.0001,t+decay);
        osc.connect(g); g.connect(master); osc.start(t); osc.stop(t+decay+0.05);
      });
    }
    if(ctx.state==='suspended') ctx.resume().then(doPlay).catch(()=>{});
    else doPlay();
  }catch(e){}
}

// ── No-Sleep ──────────────────────────────────────────────────
let wakeLock=null, noSleepVideo=null, noSleepAudio=null;

function buildNoSleepVideo(){
  const v=document.createElement('video');
  v.setAttribute('playsinline',''); v.setAttribute('muted',''); v.setAttribute('loop','');
  v.style.cssText='position:fixed;width:1px;height:1px;top:0;left:0;opacity:0;pointer-events:none;';
  v.src='data:video/mp4;base64,';
  document.body.appendChild(v); return v;
}

async function acquireWakeLock(){
  try{ if('wakeLock' in navigator){ wakeLock=await navigator.wakeLock.request('screen'); return; } }catch(e){}
  try{ if(!noSleepVideo) noSleepVideo=buildNoSleepVideo(); await noSleepVideo.play(); return; }catch(e){}
  try{
    if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
    function silentPulse(){ if(!running) return; const o=audioCtx.createOscillator(),g=audioCtx.createGain(); g.gain.value=0.00001; o.connect(g); g.connect(audioCtx.destination); o.start(); o.stop(audioCtx.currentTime+0.01); noSleepAudio=setTimeout(silentPulse,25000); }
    silentPulse();
  }catch(e){}
}

function releaseWakeLock(){
  try{ if(wakeLock){ wakeLock.release(); wakeLock=null; } }catch(e){}
  try{ if(noSleepVideo){ noSleepVideo.pause(); } }catch(e){}
  try{ if(noSleepAudio){ clearTimeout(noSleepAudio); noSleepAudio=null; } }catch(e){}
}

document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible'&&running) acquireWakeLock(); });

// ── Speech ────────────────────────────────────────────────────
function listenInstructions(){
  if(!cur) return;
  window.speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(cur.instructions);
  u.lang='en-US'; u.rate=0.88; u.pitch=1.0;
  const falar=()=>{
    const vozes=window.speechSynthesis.getVoices();
    const voz=vozes.find(v=>v.name.includes('Samantha'))||vozes.find(v=>v.lang==='en-US')||vozes.find(v=>v.lang.startsWith('en'));
    if(voz) u.voice=voz;
    window.speechSynthesis.speak(u);
  };
  if(window.speechSynthesis.getVoices().length>0){ falar(); }
  else{ window.speechSynthesis.onvoiceschanged=()=>{ window.speechSynthesis.onvoiceschanged=null; falar(); }; window.speechSynthesis.speak(new SpeechSynthesisUtterance('')); }
}

// ── State ─────────────────────────────────────────────────────
let cur=null, rounds=5, phaseIdx=0, cycleCount=0, timeLeft=0, running=false;
let ticker=null;
let wimPhase='breathe', wimBC=0, wimRetSec=0, wimRet=null, wimRound=0;

function open_(key){
  cur=P[key]; rounds=cur.defaultRounds;
  document.getElementById('rounds-val').textContent=rounds;
  document.getElementById('t-origin').textContent=cur.origin;
  document.getElementById('t-name').textContent=cur.name;
  document.getElementById('t-sub').textContent=cur.sub;
  document.getElementById('t-instructions').textContent=cur.instructions;
  document.getElementById('done-sub').textContent=cur.doneSub;
  ring.style.stroke=COLORS[cur.color]||COLORS.cool;
  const isWim=!!cur.isWim;
  document.getElementById('wim-dots').classList.toggle('show',isWim);
  document.getElementById('rounds-row').style.display=isWim?'none':'';
  if(isWim) buildDots();
  document.getElementById('timer-overlay').classList.add('active');
  document.getElementById('timer-main').style.display='';
  document.getElementById('done-msg').classList.remove('show');
  resetTimer();
}

function buildDots(){
  const el=document.getElementById('wim-dots'); el.innerHTML='';
  for(let i=0;i<3;i++){ const d=document.createElement('div'); d.className='wim-dot'; d.id='wd'+i; d.textContent='R'+(i+1); el.appendChild(d); }
}

function resetTimer(){
  clearInterval(ticker); clearInterval(wimRet);
  running=false; phaseIdx=0; cycleCount=0; timeLeft=0;
  wimPhase='breathe'; wimBC=0; wimRetSec=0; wimRound=0;
  document.getElementById('ss-btn').textContent='start';
  document.getElementById('done-msg').classList.remove('show');
  document.getElementById('timer-main').style.display='';
  document.getElementById('wim-ret-panel').classList.remove('show');
  if(cur&&cur.isWim){ buildDots(); showWimBreath(); } else updateDisp();
}

function goBack(){
  clearInterval(ticker); clearInterval(wimRet); running=false;
  window.speechSynthesis.cancel();
  releaseWakeLock();
  document.getElementById('timer-overlay').classList.remove('active');
}

function toggleTimer(){ running ? pauseT() : startT(); }

function pauseT(){
  clearInterval(ticker); clearInterval(wimRet); running=false;
  releaseWakeLock();
  document.getElementById('ss-btn').textContent='continuar';
}

function startT(){
  try{ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)(); if(audioCtx.state==='suspended') audioCtx.resume(); }catch(e){}
  running=true; acquireWakeLock();
  document.getElementById('ss-btn').textContent='pausar';
  if(cur.isWim){ startWim(); }
  else{ if(timeLeft<=0) timeLeft=cur.phases[phaseIdx].duration; ticker=setInterval(tick,50); }
}

function tick(){
  timeLeft-=0.05;
  if(timeLeft<=0){
    phaseIdx++;
    if(phaseIdx>=cur.phases.length){ phaseIdx=0; cycleCount++; }
    if(cycleCount>=rounds){ clearInterval(ticker); running=false; bell('done'); showDone(); return; }
    timeLeft=cur.phases[phaseIdx].duration;
    bell('phase');
  }
  updateDisp();
}

function updateDisp(){
  if(!cur||cur.isWim) return;
  const ph=cur.phases[phaseIdx], total=ph.duration, progress=(total-timeLeft)/total;
  ring.style.strokeDashoffset=CIRC*(1-Math.min(progress,1));
  document.getElementById('phase-label').textContent=ph.label;
  document.getElementById('count-display').textContent=Math.ceil(Math.max(timeLeft,0));
  document.getElementById('cycles-info').textContent=cur.roundsLabel+': '+(cycleCount+1)+' / '+rounds;
}

function showWimBreath(){
  document.getElementById('wim-ret-panel').classList.remove('show');
  const left=cur.breaths-wimBC;
  document.getElementById('phase-label').textContent=wimPhase==='recovery'?'Recovery breath':'Deep breath';
  document.getElementById('count-display').textContent=left>0?left:'—';
  document.getElementById('unit-label').textContent='breaths';
  document.getElementById('cycles-info').textContent='Round '+(wimRound+1)+' / 3';
  ring.style.strokeDashoffset=CIRC*(1-wimBC/cur.breaths);
  for(let i=0;i<3;i++){
    const d=document.getElementById('wd'+i); if(!d) continue;
    d.classList.remove('active','done');
    if(i<wimRound) d.classList.add('done'); else if(i===wimRound) d.classList.add('active');
  }
}

function startWim(){
  if(wimPhase==='retention') return;
  if(timeLeft<=0) timeLeft=wimPhase==='recovery'?15:1.5;
  ticker=setInterval(wimTick,50);
}

function wimTick(){
  timeLeft-=0.05;
  if(timeLeft<=0){
    if(wimPhase==='recovery'){
      wimRound++; if(wimRound>=3){ clearInterval(ticker); running=false; bell('done'); showDone(); return; }
      wimPhase='breathe'; wimBC=0; timeLeft=1.5; bell('phase'); showWimBreath(); return;
    }
    wimBC++; ring.style.strokeDashoffset=CIRC*(1-wimBC/cur.breaths);
    document.getElementById('count-display').textContent=cur.breaths-wimBC;
    if(wimBC>=cur.breaths){ clearInterval(ticker); wimPhase='retention'; bell('phase'); enterRet(); return; }
    timeLeft=1.5;
  }
}

function enterRet(){
  document.getElementById('wim-ret-panel').classList.add('show');
  ring.style.strokeDashoffset=CIRC;
  document.getElementById('phase-label').textContent='Retention';
  document.getElementById('count-display').textContent='—';
  wimRetSec=0; document.getElementById('wim-ret-sec').textContent=0;
  const goal=cur.retGoals[wimRound]||120;
  document.getElementById('wim-ret-sub').textContent='seconds  ·  meta: '+goal+'s';
  wimRet=setInterval(()=>{ wimRetSec++; document.getElementById('wim-ret-sec').textContent=wimRetSec; ring.style.strokeDashoffset=CIRC*(1-Math.min(wimRetSec/goal,1)); },1000);
}

function endRetention(){
  clearInterval(wimRet);
  document.getElementById('wim-ret-panel').classList.remove('show');
  wimPhase='recovery'; timeLeft=15;
  document.getElementById('phase-label').textContent='Recovery';
  document.getElementById('count-display').textContent=15;
  document.getElementById('unit-label').textContent='sec';
  ring.style.strokeDashoffset=CIRC; bell('phase');
  if(running) ticker=setInterval(wimTick,50);
}

function changeRounds(d){ rounds=Math.max(1,Math.min(99,rounds+d)); document.getElementById('rounds-val').textContent=rounds; }

function showDone(){
  document.getElementById('timer-main').style.display='none';
  document.getElementById('done-msg').classList.add('show');
  releaseWakeLock();
}
</script>

